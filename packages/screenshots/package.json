{
	"name": "@wporg-docs/screenshots",
	"version": "0.2.0",
	"description": "Reproducible WordPress UI screenshots for documentation: boots WordPress Playground from a blueprint and captures YAML-defined shots with Playwright.",
	"keywords": [
		"wordpress",
		"documentation",
		"screenshots",
		"playwright",
		"playground"
	],
	"homepage": "https://github.com/ndiego/documentation-toolkit/tree/trunk/packages/screenshots#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ndiego/documentation-toolkit.git",
		"directory": "packages/screenshots"
	},
	"bugs": "https://github.com/ndiego/documentation-toolkit/issues",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"bin": {
		"wp-screenshots": "./src/cli.js"
	},
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src",
		"README.md",
		"ARCHITECTURE.md"
	],
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"dependencies": {
		"@playwright/test": "1.64.0",
		"@wordpress/e2e-test-utils-playwright": "3.0.0",
		"@wp-playground/cli": "3.1.57",
		"@wporg-docs/demo-site": "0.2.0",
		"pixelmatch": "^8.0.0",
		"sharp": "^0.34.0",
		"yaml": "^2.8.0"
	}
}
