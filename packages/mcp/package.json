{
	"name": "@wp-docs-toolkit/mcp",
	"version": "0.3.1",
	"description": "MCP server for the WordPress documentation toolkit: take reproducible WordPress UI screenshots and validate handbook manifests from Claude, ChatGPT or any MCP client.",
	"keywords": [
		"wordpress",
		"documentation",
		"screenshots",
		"mcp",
		"model-context-protocol"
	],
	"homepage": "https://github.com/ndiego/wp-docs-toolkit/tree/trunk/packages/mcp#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ndiego/wp-docs-toolkit.git",
		"directory": "packages/mcp"
	},
	"bugs": "https://github.com/ndiego/wp-docs-toolkit/issues",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"bin": {
		"wp-docs-mcp": "./src/cli.js"
	},
	"exports": {
		".": "./src/server.js"
	},
	"files": [
		"src",
		"README.md"
	],
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@wp-docs-toolkit/manifest": "0.3.1",
		"@wp-docs-toolkit/screenshots": "0.3.1",
		"sharp": "^0.34.0",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	}
}
