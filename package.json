{
	"name": "documentation-toolkit",
	"private": true,
	"description": "Tooling for writing and maintaining WordPress.org documentation: screenshot engine, manifest validator, conventions, and agent skills.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "npm test --workspaces --if-present"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/prettier-config": "^4.57.0",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"prettier": "npm:wp-prettier@^3.9.6"
	}
}
