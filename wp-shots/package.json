{
  "name": "wp-shots",
  "version": "0.1.0",
  "description": "Declarative, reproducible WordPress UI screenshots: boots WordPress Playground from a blueprint and captures YAML-defined shots with Playwright.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "bin": {
    "wp-shots": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@playwright/test": "1.64.0",
    "@wordpress/e2e-test-utils-playwright": "3.0.0",
    "@wp-playground/cli": "3.1.57",
    "pixelmatch": "^8.0.0",
    "sharp": "^0.34.0",
    "yaml": "^2.8.0"
  }
}
